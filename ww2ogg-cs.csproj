<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ww2ogg</RootNamespace>
    <AssemblyName>ww2ogg-cs</AssemblyName>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <PublishAot>True</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="1.1.6" />
    <PackageReference Include="GroovyMp3" Version="0.1.3" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <!-- External Vorbis codebook databases (required unless inline codebooks
       are used); packed_codebooks.bin is the default, aoTuV_603 covers newer
       WEM builds -->
  <ItemGroup>
    <None Include="packed_codebooks.bin" Link="packed_codebooks.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="packed_codebooks_aoTuV_603.bin" Link="packed_codebooks_aoTuV_603.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
